# mount_name: directory under /mnt; share_name: ksmbd share name.
#   'label'       volume label, or the device name if it has none
#   text with %d  %d is replaced by the device name: 'volume(%d)' -> volume(sda1)
#   other text    fixed name, numbered from the second device: 'usb' -> usb, usb2, ...

config autoshare 'global'
	option mount_name 'label'
	option share_name 'label'
