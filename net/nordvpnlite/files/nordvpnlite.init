#!/bin/sh /etc/rc.common

USE_PROCD=1
START=99
STOP=01
PROG=/usr/sbin/nordvpnlite

extra_command "manual_start" "Start the service without changing option enabled"

nordvpnlite_enabled() {
  local enabled

  config_load nordvpnlite
  config_get enabled settings enabled 0

  [ "$enabled" = "1" ]
}

start_instance() {
  local instance="${1:-automatic}"

  echo "Starting nordvpnlite service"
  procd_open_instance "$instance"
  procd_set_param command "$PROG" start --no-detach
  procd_set_param stdout 1
  procd_set_param stderr 1
  # By default procd will try to respawn the process every 5 seconds.
  # if in the first 3600 seconds, the process dies 5 times, procd gives up
  procd_set_param respawn
  procd_close_instance
}

start_service() {
  if ! nordvpnlite_enabled; then
    echo "NordVPN Lite disabled by /etc/config/nordvpnlite"
    return 0
  fi

  start_instance
}

start_manual_instance() {
  start_instance manual
}

manual_start() {
  rc_procd start_manual_instance
}

stop_service() {
  echo "Stopping nordvpnlite service"
  "$PROG" stop
}

reload_service() {
  if ! nordvpnlite_enabled; then
    if service_running manual; then
      echo "Reloading manually started nordvpnlite service"
      "$PROG" reload
      return
    fi

    echo "Stopping nordvpnlite service disabled by /etc/config/nordvpnlite"
    "$PROG" stop

    # Replace the procd service definition with an empty one so that a
    # supervised instance cannot be respawned after it has been disabled.
    rc_procd start_service
    return
  fi

  if service_running; then
    echo "Reloading nordvpnlite configuration"
    "$PROG" reload
    return
  fi

  # Clean up an instance started outside procd before registering a new one.
  "$PROG" stop >/dev/null 2>&1
  rc_procd start_service
}

service_triggers() {
  procd_add_reload_trigger nordvpnlite
}
